<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="manometro3">

    <static>true</static>

    <link name="link">

      <!-- Apenas visual -->
      <visual name="visual">
        <geometry>
          <plane>
            <size>0.127 0.127</size>
            <normal>0 0 1</normal>
          </plane>
        </geometry>

        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>

          <pbr>
            <metal>
              <albedo_map>
                model://manometro3/materials/textures/manometro3.png
              </albedo_map>

              <roughness>1.0</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- Colisão simplificada -->
      <collision name="collision">
        <geometry>
          <box>
            <size>0.127 0.127 0.001</size>
          </box>
        </geometry>
      </collision>

    </link>
  </model>
</sdf>