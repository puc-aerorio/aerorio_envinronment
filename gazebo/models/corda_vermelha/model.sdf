<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="corda_vermelha">
    <static>true</static>

    <link name="corda_link">

      <pose>0 0 0 0 1.57 0</pose>

      <!-- VISUAL -->
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.009</radius>
            <length>10.0</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>1 0 0 1</ambient>
          <diffuse>1 0 0 1</diffuse>
        </material>
      </visual>

      <!-- COLISÃO -->
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.02</radius> <!-- hitbox maior -->
            <length>10.0</length>
          </cylinder>
        </geometry>
      </collision>

    </link>
  </model>
</sdf>
