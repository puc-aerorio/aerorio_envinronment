<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="esfera_laranja">
    <static>true</static>

    <link name="esfera_link">

      <pose>0 0 0 0 0 0</pose> <!-- altura ajustável -->

      <!-- VISUAL -->
      <visual name="visual">
        <geometry>
          <sphere>
            <radius>0.125</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>1 0.35 0 1</ambient>
	  <diffuse>1 0.35 0 1</diffuse>
        </material>
      </visual>

      <!-- COLISÃO -->
      <collision name="collision">
        <geometry>
          <sphere>
            <radius>0.125</radius>
          </sphere>
        </geometry>
      </collision>

    </link>
  </model>
</sdf>
